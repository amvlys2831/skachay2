import i2c_adc as ac
import time
import matplotlib.pyplot as plt
import RPi.GPIO as gpio


# Настройки
mxv = 5.150
time_measure = 0.001

charge_voltage = 4.68
discharge_voltage = 0.05

control_pin = 14

# Создание АЦП
adc = ac.MCP3021(mxv)

# Массивы для графика
x = []
y = []


gpio.setmode(gpio.BCM)
gpio.setup(control_pin, gpio.OUT, initial=0)


try:
    # 1. Ожидание полной разрядки конденсатора
    gpio.output(control_pin, 0)

    print("Ожидание разрядки конденсатора...")

    while True:
        voltage = adc.get_voltage()

        if voltage <= discharge_voltage:
            break

        time.sleep(time_measure)

    print("Конденсатор разряжен.")
    print("Начало зарядки...")

    # 2. Зарядка конденсатора
    gpio.output(control_pin, 1)

    time_start = time.monotonic()

    while True:
        voltage = adc.get_voltage()
        current_time = time.monotonic() - time_start

        x.append(current_time)
        y.append(voltage)

        if voltage >= charge_voltage:
            break

        time.sleep(time_measure)

    print("Зарядка завершена.")
    print("Начало разрядки...")

    # 3. Разрядка конденсатора
    gpio.output(control_pin, 0)

    while True:
        voltage = adc.get_voltage()
        current_time = time.monotonic() - time_start

        x.append(current_time)
        y.append(voltage)

        if voltage <= discharge_voltage:
            break

        time.sleep(time_measure)

    print("Измерение завершено.")


finally:
    # Выключение управляющего сигнала и освобождение ресурсов
    gpio.output(control_pin, 0)
    gpio.cleanup()
    adc.deinit()


# 4. Построение графика — исходное оформление
plt.figure(figsize=(10, 6))

plt.ticklabel_format(
    style='sci',
    axis='both',
    scilimits=(0, 0),
    useMathText=True
)

plt.minorticks_on()

plt.grid(
    visible=True,
    which='major',
    linestyle='-',
    linewidth=1.5,
    color='0.7'
)

plt.grid(
    visible=True,
    which='minor',
    linestyle='--',
    linewidth=1,
    color='0.8'
)

plt.xlabel(r"$T, seconds$")
plt.ylabel(r"$U, Volts$")

plt.plot(
    x,
    y,
    label='graph',
    marker='',
    linestyle='-',
    color='#abcf40',
    linewidth=1
)

plt.show()
